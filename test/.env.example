# Names only. The nightly sandbox acceptance job sets these as repository secrets; without them the suite runs
# against MockBcServer and the fakes (and needs only DATABASE_URL). Nothing here ever points at production.
DATABASE_URL=                      # postgres://... a throwaway test database
BC_SANDBOX_TENANT_ID=
BC_SANDBOX_ENVIRONMENT=CADE_Sandbox_vs25
BC_SANDBOX_COMPANY_ID=
BC_SANDBOX_CLIENT_ID=
BC_SANDBOX_CERT_PEM=               # the PEM (key + certificate) text from the CI secret store
BC_SANDBOX_CONNECTOR_INSTALLED=true
HEALTH_REPORT_PATH=                # where to write health.json (default test/test-results/health.json)
