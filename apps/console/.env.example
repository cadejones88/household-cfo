# Names only. The Console is a static site: every value here is public configuration, never a secret.
# Local mock mode (no API, synthetic data): VITE_API_MODE=mock VITE_AUTH_MODE=dev
VITE_API_MODE=http                 # http | mock
VITE_API_BASE_URL=http://localhost:8080
VITE_AUTH_MODE=dev                 # dev (sends x-dev-member) | entra
VITE_DEV_MEMBER_ID=                # member id for AUTH_MODE=dev on the API
VITE_DEV_MEMBER_NAME=Cade

# Entra External ID (same tenant as the phone app). Client ID of the Console SPA app registration.
VITE_ENTRA_CLIENT_ID=
VITE_ENTRA_AUTHORITY=              # https://homesteadfamily.ciamlogin.com/<tenant id>/ or https://homestead.cadejonescpa.com/<tenant id>/
VITE_ENTRA_KNOWN_AUTHORITY=        # homesteadfamily.ciamlogin.com or homestead.cadejonescpa.com
VITE_ENTRA_API_SCOPE=              # api://<api client id>/Household.ReadWrite
VITE_SESSION_HOURS=12

# Business Central deep links (no credential; opens BC in the browser with Cade's own sign-in)
VITE_BC_TENANT=                    # the firm's workforce tenant id or domain
VITE_BC_ENVIRONMENT=CADE_Sandbox_vs25
VITE_BC_COMPANY=                   # company display name as BC's ?company= wants it
VITE_BC_JOURNAL_TEMPLATE=HHAPP
