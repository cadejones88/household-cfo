{
  "name": "@homestead/console",
  "version": "0.1.0",
  "private": true,
  "description": "Homestead Console: the desktop CFO view (work queues, BC sync and posting, reconciliation, mappings, authority matrix, connection health and audit)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:mock": "VITE_API_MODE=mock VITE_AUTH_MODE=dev vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@azure/msal-browser": "^5.25.0",
    "@homestead/shared": "workspace:*",
    "@tanstack/react-query": "^5.90.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "^7.9.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.0",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.7.0",
    "vite": "^7.1.0",
    "vitest": "^3.1.0"
  }
}
