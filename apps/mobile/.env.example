# Names only. Values live in EAS secrets (cloud builds) or a local .env that is never committed.
# Everything the app reads must start with EXPO_PUBLIC_ (Expo inlines these at build time); nothing here is secret.

# Where the API lives. Local: http://localhost:8080 (iOS simulator) or http://<your-lan-ip>:8080 (a phone).
EXPO_PUBLIC_API_URL=
# http (talk to the API) or mock (serve the prototype's sample data; no backend needed)
EXPO_PUBLIC_API_MODE=mock
# dev (send x-dev-member; the API must run with AUTH_MODE=dev) or entra (Entra External ID sign-in)
EXPO_PUBLIC_AUTH_MODE=dev
# dev mode only: "Name:memberId,Name:memberId" from the seed, e.g. Vanessa:<uuid>,Cade:<uuid>
EXPO_PUBLIC_DEV_MEMBERS=

# Entra External ID (entra mode). The tenant is owned by Cade T. Jones CPA, P.C.
EXPO_PUBLIC_ENTRA_TENANT_NAME=            # e.g. homesteadfamily (the <tenant>.ciamlogin.com part)
EXPO_PUBLIC_ENTRA_TENANT_ID=              # the tenant's GUID (used in the issuer path when set)
EXPO_PUBLIC_ENTRA_CUSTOM_DOMAIN=          # homestead.cadejonescpa.com (passkeys bind to this domain)
EXPO_PUBLIC_ENTRA_CLIENT_ID=              # the phone app registration (public client, PKCE)
EXPO_PUBLIC_ENTRA_API_SCOPE=              # api://<api-client-id>/Household.ReadWrite

# Push (EAS project id is also read from app.json extra.eas.projectId)
EXPO_PUBLIC_EAS_PROJECT_ID=

# Who fixes entries already in the books ("Cade will fix it in the books"). Defaults to Cade.
EXPO_PUBLIC_BOOKKEEPER_NAME=
