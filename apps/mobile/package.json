{
  "name": "@homestead/mobile",
  "version": "0.1.0",
  "private": true,
  "description": "Homestead: the household's phone app (Expo). Household Home, receipt capture with an offline queue, Face ID, push",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "doctor": "expo-doctor"
  },
  "dependencies": {
    "@expo-google-fonts/fraunces": "^0.4.1",
    "@homestead/shared": "workspace:*",
    "@tanstack/react-query": "^5.104.5",
    "expo": "~58.0.16",
    "expo-auth-session": "~58.0.13",
    "expo-camera": "~58.0.11",
    "expo-constants": "~58.0.12",
    "expo-crypto": "~58.0.7",
    "expo-dev-client": "~58.0.14",
    "expo-file-system": "~58.0.10",
    "expo-font": "~58.0.9",
    "expo-image-manipulator": "~58.0.15",
    "expo-linking": "~58.0.13",
    "expo-local-authentication": "~58.0.2",
    "expo-network": "~58.0.3",
    "expo-notifications": "~58.1.5",
    "expo-router": "~58.0.24",
    "expo-secure-store": "~58.0.2",
    "expo-sensors": "~58.0.4",
    "expo-splash-screen": "~58.0.10",
    "expo-status-bar": "~58.0.3",
    "expo-web-browser": "~58.0.6",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-worklets": "0.13.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "typescript": "^5.7.0",
    "vitest": "^3.1.0"
  }
}
