# Names only. Values live in Key Vault (cloud) or a local .env that is never committed.
NODE_ENV=development
PORT=8080
LOG_LEVEL=info
DATABASE_URL=                      # postgres://... (local dev only; cloud uses managed identity)
PGSSLMODE=require

# Entra External ID (sign-in for both spouses)
ENTRA_TENANT_ID=
ENTRA_TENANT_DOMAIN=               # homestead.cadejonescpa.com
ENTRA_API_AUDIENCE=                # the API app registration's client ID
ENTRA_ISSUER=

# Business Central (service-to-service; certificate in Key Vault, never on a phone)
BC_TENANT_ID=
BC_ENVIRONMENT=CADE_Sandbox_vs25
BC_COMPANY_ID=
BC_CLIENT_ID=
BC_CERT_SECRET_REF=                # Key Vault secret name holding the PEM certificate
BC_API_BASE_URL=https://api.businesscentral.dynamics.com/v2.0
BC_JOURNAL_TEMPLATE=HHAPP
BC_CONNECTOR_INSTALLED=true         # false until bc/hh-app-connector is published to the environment

# Plaid (Sandbox for dev; Trial plan with live read-only logins for the pilot)
PLAID_ENV=sandbox
PLAID_CLIENT_ID=
PLAID_SECRET_REF=
PLAID_WEBHOOK_URL=

# Azure
KEY_VAULT_URL=
STORAGE_ACCOUNT_URL=
SERVICE_BUS_NAMESPACE=              # e.g. homestead-dev-sb (topic homestead-outbox)
SERVICE_BUS_SUBSCRIPTION=bc-worker    # the subscription a consumer reads; OUTBOX_SUBSCRIPTION (set per event job) wins
WEBHOOK_BASE_URL=                   # jobs: the API's public URL, for BC webhook subscriptions
AZURE_CLIENT_ID=                    # the user-assigned managed identity's client id
PGHOST=                             # Azure: managed-identity sign-in when DATABASE_URL is unset
PGUSER=
PGDATABASE=
DOCUMENT_INTELLIGENCE_ENDPOINT=
DOCUMENT_INTELLIGENCE_KEY_REF=      # optional Key Vault secret name; managed identity when unset
FOUNDRY_ENDPOINT=
FOUNDRY_MODEL=
FOUNDRY_KEY_REF=                   # Key Vault secret name for the Foundry api-key
BLOB_CONTAINER=receipts
CORS_ORIGINS=                      # comma-separated Console origins
AUTH_MODE=                         # dev | entra (entra by default in production)
APPLICATIONINSIGHTS_CONNECTION_STRING=
